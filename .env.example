# Copier ce fichier en .env puis remplir les valeurs.
# .env est exclu de Git (voir .gitignore) : c'est le SEUL endroit où mettre le token.

# --- Caddy / DuckDNS ---
DOMAIN=remi-chat.duckdns.org
DUCKDNS_TOKEN=
# Fréquence de mise à jour de l'IP chez DuckDNS (secondes)
DUCKDNS_INTERVAL_SECONDS=300

# --- Modèle (Ollama) ---
# Tag exact à confirmer à l'étape 4 (ollama pull)
OLLAMA_MODEL=qwen3:14b
# Taille du contexte envoyée au modèle (tokens)
OLLAMA_NUM_CTX=8192

# --- API FastAPI ---
# Origine(s) autorisée(s) par CORS (schéma + domaine, sans slash final), séparées par des virgules.
# En développement du client web, ajouter http://localhost:8080 (à retirer en production).
ALLOWED_ORIGIN=https://exemple.fr
# Limite de requêtes de chat par IP (syntaxe slowapi)
RATE_LIMIT=10/minute
# Taille max d'un message utilisateur (caractères)
MAX_MESSAGE_CHARS=1000
# Nombre max de messages d'historique transmis au modèle
MAX_HISTORY_MESSAGES=10
# Longueur max d'une réponse du modèle (tokens)
MAX_OUTPUT_TOKENS=1500
# Nombre de générations simultanées (au-delà : réponse 503 "busy")
MAX_CONCURRENT_GENERATIONS=2
# Timeout d'une génération (secondes)
REQUEST_TIMEOUT_SECONDS=120
